{
  "name": "personal-universe",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "reuse:approve": "node scripts/reuse-gate.mjs approve docs/reuse-gate/current.json",
    "gate:reuse": "node scripts/reuse-gate.mjs check working",
    "gate:reuse:staged": "node scripts/reuse-gate.mjs check staged",
    "content:new": "node --experimental-strip-types scripts/content-author.mjs new",
    "content:import": "node --experimental-strip-types scripts/content-author.mjs import",
    "content:migrate": "node --experimental-strip-types scripts/content-author.mjs migrate",
    "content:validate": "node --experimental-strip-types scripts/content-author.mjs validate",
    "content:preview": "node --experimental-strip-types scripts/content-author.mjs preview",
    "content:index": "node --experimental-strip-types scripts/content-author.mjs index",
    "test:content": "node --experimental-strip-types --test tests/content-authoring.test.ts tests/content-placement.test.ts",
    "predev": "npm run gate:reuse && npm run content:validate",
    "dev": "astro dev",
    "prebuild": "npm run gate:reuse && npm run content:validate && npm run test:content",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "catalog:refresh": "node scripts/fetch-astronomy-catalog.mjs",
    "reuse:approve:task": "node scripts/reuse-gate.mjs approve",
    "gate:reuse:ci": "node scripts/reuse-gate.mjs check ci"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@theatre/core": "^0.7.2",
    "@theatre/r3f": "^0.7.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "astro": "^7.4.13",
    "camera-controls": "^3.1.2",
    "gsap": "^3.15.1",
    "howler": "^2.2.4",
    "postprocessing": "^6.39.6",
    "procedural-planets": "^0.5.1",
    "procedural-terrains": "^2.0.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/three": "^0.185.1"
  }
}
