---
import { getCollection } from "astro:content";
import UniverseApp from "../components/universe/UniverseApp";
import type { UniverseContentEntry } from "../lib/universe/content";

const portfolio = await getCollection("portfolio", ({ data }) => !data.draft);
const contentEntries: UniverseContentEntry[] = portfolio.map(({ id, data }) => ({
  id,
  title: data.title,
  summary: data.summary,
  kind: data.kind,
  status: data.status,
  importance: data.importance,
  tags: data.tags,
  featured: data.featured,
  placement: data.placement,
  ...(data.placementKey ? { placementKey: data.placementKey } : {}),
  ...(data.starId ? { starId: data.starId } : {}),
  ...(data.href ? { href: data.href } : {}),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Personal Universe: an explorable portfolio mapped onto observed and procedural worlds."
    />
    <meta name="theme-color" content="#010207" />
    <title>Personal Universe</title>
  </head>
  <body>
    <UniverseApp client:load contentEntries={contentEntries} />
  </body>
</html>
