---
import { getCollection } from "astro:content";
import UniverseApp from "../components/universe/UniverseApp";
import {
  assertUniverseContentCatalog,
  type UniverseContentEntry,
} from "../lib/universe/content";
import { buildGalaxyIndex } from "../lib/universe/generation";

const portfolio = await getCollection("portfolio", ({ data }) => !data.draft);
const contentEntries: UniverseContentEntry[] = portfolio.map(({ data }) => ({
  id: data.contentId,
  schemaVersion: data.schemaVersion,
  title: data.title,
  summary: data.summary,
  ...(data.body ? { body: data.body } : {}),
  i18n: data.i18n,
  aliases: data.aliases,
  kind: data.kind,
  status: data.status,
  ...(data.dateStart ? { dateStart: data.dateStart } : {}),
  ...(data.dateEnd ? { dateEnd: data.dateEnd } : {}),
  importance: data.importance,
  tags: data.tags,
  featured: data.featured,
  signalVisible: data.signalVisible,
  placement: data.placement,
  ...(data.placementKey ? { placementKey: data.placementKey } : {}),
  ...(data.starId ? { starId: data.starId } : {}),
  ...(data.href ? { href: data.href } : {}),
  links: data.links,
  media: data.media,
  ...(data.surface ? { surface: data.surface } : {}),
  provenance: data.provenance,
  relations: data.relations,
  journeys: data.journeys,
  legacyIds: data.legacyIds,
}));

const canonicalGalaxy = buildGalaxyIndex("personal-universe-v2");
assertUniverseContentCatalog(contentEntries, canonicalGalaxy.markers);
const visibleContentEntries = contentEntries.filter(
  (entry) => entry.signalVisible !== false,
);

const pageTitle = "Personal Universe";
const pageDescription =
  "An explorable personal universe where projects, research, and artifacts become stars, worlds, and journeys.";
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin,
);
const socialPreviewUrl = new URL(
  `${import.meta.env.BASE_URL}social-preview.png`,
  Astro.site ?? Astro.url.origin,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialPreviewUrl.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="900" />
    <meta
      property="og:image:alt"
      content="Personal Universe galaxy view with navigable stars and personal signals"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialPreviewUrl.href} />
    <meta
      name="twitter:image:alt"
      content="Personal Universe galaxy view with navigable stars and personal signals"
    />
    <meta name="theme-color" content="#010207" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <UniverseApp client:load contentEntries={visibleContentEntries} />
  </body>
</html>
